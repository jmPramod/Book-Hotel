{
  "swagger": "2.0",
  "info": {
    "title": "Book Hotel API Documentation",
    "description": "API documentation for Hotel operations and Hotel management",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
   
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Endpoints for user authentication"
    }
  ],
  "paths": {
    "/api/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User registration",
        "description": "Creates a new user account with the provided details.",
        "parameters": [
          {
            "in": "body",
            "name": "user",
            "description": "User registration details",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegisterUser"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created successfully",
            "schema": {
              "$ref": "#/definitions/RegisterUser"
            }
          },
          "401": {
            "description": "User already exists or validation error",
            "schema": {
              "type": "object",
              "properties": {
                "Success": {
                  "type": "boolean",
                  "example": true
                },
                "status": {
                  "type": "integer",
                  "example": 201
                },
                "message": {
                  "type": "string",
                  "example": "New User created"
                },
                "data": {
                  "$ref": "#/definitions/RegisterUser"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User login",
        "description": "Authenticates a user with the provided credentials (username and password).",
        "parameters": [
          {
            "in": "body",
            "name": "login",
            "description": "Login credentials",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginUser"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User logged in successfully",
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "example": "JWT_TOKEN_STRING"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Invalid username or password"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
     
   "RegisterUser": {
  "type": "object",
  "properties": {
    "firstName": { "type": "string", "example": "John" },
    "lastName": { "type": "string", "example": "Doe" },
    "phone": { "type": "number", "example": 9876543210 },
    "address": { "type": "string", "example": "123 MG Road, Bangalore" },
    "state": { "type": "string", "example": "Karnataka" },
    "country": { "type": "string", "example": "India" },
    "pinCode": { "type": "number", "example": 560001 },
    "email": { "type": "string", "example": "john@example.com" },
    "password": { "type": "string", "example": "SecurePass@123" },
    "isAdmin": { 
      "type": "string",
      "enum": ["admin", "user"],
      "example": "user",
      "default": "user"
    },
    "profileImage": {
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "example": "https://res.cloudinary.com/dtvq8ysaj/image/upload/v1720770108/Global%20Images/profile_new-removebg-preview_motz7n.png"
        },
        "imgPublicId": {
          "type": "string",
          "example": null
        }
      }
    }
  },
  "required": ["firstName", "lastName", "email", "password", "phone"]
}
,
    "LoginUser": {
      "type": "object",
      "properties": {
        "email": { "type": "string", "example": "john_doe" },
        "password": { "type": "string", "example": "securepassword" }
      }
    }
  },
  "securityDefinitions": {
    "JWTAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT Authorization header using the Bearer scheme. Example: \"Authorization: Bearer <token>\""
    }
  },
  "security": [
    {
      "JWTAuth": []
    }
  ]
}
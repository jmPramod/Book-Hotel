{
"swagger": "2.0",
"info": {
"title": "Money Tracker API Documentation",
"description": "API documentation for Money Tracker, User authentication, and Expense/Income tracking with Dashboard",
"version": "1.0.0"
},
"servers": [
{ "url": "http://localhost:3000", "description": "Local server" }
],
"tags": [
{ "name": "Authentication", "description": "Endpoints for user authentication" },
{ "name": "Expense", "description": "Endpoints for managing user expenses" },
{ "name": "Income", "description": "Endpoints for managing user incomes" },
{ "name": "Dashboard", "description": "Endpoint to fetch user dashboard summary" }
],
"paths": {
"/api/register": {
"post": {
"tags": ["Authentication"],
"summary": "User registration",
"parameters": [
{ "in": "body", "name": "user", "required": true, "schema": { "$ref": "#/definitions/User" } }
],
"responses": { "201": { "description": "User created successfully" }, "401": { "description": "User already exists" } }
}
},
"/api/login": {
"post": {
"tags": ["Authentication"],
"summary": "User login",
"parameters": [
{ "in": "body", "name": "login", "required": true, "schema": { "$ref": "#/definitions/LoginUser" } }
],
"responses": { "200": { "description": "User logged in successfully" }, "401": { "description": "Invalid credentials" } }
}
},
"/api/expense": {
"post": {
"tags": ["Expense"],
"summary": "Add new expense",
"parameters": [{ "in": "body", "name": "expense", "required": true, "schema": { "$ref": "#/definitions/Expense" } }],
"security": [{ "JWTAuth": [] }],
"responses": { "201": { "description": "Expense added successfully" } }
},
"get": {
"tags": ["Expense"],
"summary": "Get all expenses",
"security": [{ "JWTAuth": [] }],
"responses": { "200": { "description": "List of expenses", "schema": { "type": "array", "items": { "$ref": "#/definitions/Expense" } } } }
}
},
"/api/expense/{id}": {
"delete": {
"tags": ["Expense"],
"summary": "Delete an expense",
"parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
"security": [{ "JWTAuth": [] }],
"responses": { "200": { "description": "Expense deleted successfully" } }
},
"patch": {
"tags": ["Expense"],
"summary": "Update an expense",
"parameters": [
{ "name": "id", "in": "path", "required": true, "type": "string" },
{ "in": "body", "name": "expense", "required": true, "schema": { "$ref": "#/definitions/Expense" } }
],
"security": [{ "JWTAuth": [] }],
"responses": { "200": { "description": "Expense updated successfully" } }
}
},
"/api/download-expense-excel": {
"get": {
"tags": ["Expense"],
"summary": "Download expenses as Excel",
"security": [{ "JWTAuth": [] }],
"responses": { "200": { "description": "Excel file generated successfully" } }
}
},
"/api/income": {
"post": {
"tags": ["Income"],
"summary": "Add new income",
"parameters": [{ "in": "body", "name": "income", "required": true, "schema": { "$ref": "#/definitions/Income" } }],
"security": [{ "JWTAuth": [] }],
"responses": { "201": { "description": "Income added successfully" } }
},
"get": {
"tags": ["Income"],
"summary": "Get all incomes",
"security": [{ "JWTAuth": [] }],
"responses": { "200": { "description": "List of incomes", "schema": { "type": "array", "items": { "$ref": "#/definitions/Income" } } } }
}
},
"/api/income/{id}": {
"delete": {
"tags": ["Income"],
"summary": "Delete an income",
"parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
"security": [{ "JWTAuth": [] }],
"responses": { "200": { "description": "Income deleted successfully" } }
},
"patch": {
"tags": ["Income"],
"summary": "Update an income",
"parameters": [
{ "name": "id", "in": "path", "required": true, "type": "string" },
{ "in": "body", "name": "income", "required": true, "schema": { "$ref": "#/definitions/Income" } }
],
"security": [{ "JWTAuth": [] }],
"responses": { "200": { "description": "Income updated successfully" } }
}
},
"/api/download-income-excel": {
"get": {
"tags": ["Income"],
"summary": "Download incomes as Excel",
"security": [{ "JWTAuth": [] }],
"responses": { "200": { "description": "Excel file generated successfully" } }
}
},
"/api/dashboard": {
"get": {
"tags": ["Dashboard"],
"summary": "Get dashboard info",
"description": "Fetches total income, total expense, recent transactions, and last 30/60 days summaries for the authenticated user.",
"security": [{ "JWTAuth": [] }],
"responses": {
"200": {
"description": "Dashboard info fetched successfully",
"schema": { "$ref": "#/definitions/DashboardResponse" }
},
"400": { "description": "Invalid user ID" }
}
}
}
},
"definitions": {
"User": {
"type": "object",
"properties": {
"firstName": { "type": "string" },
"lastName": { "type": "string" },
"phone": { "type": "number" },
"address": { "type": "string" },
"state": { "type": "string" },
"country": { "type": "string" },
"pinCode": { "type": "number" },
"email": { "type": "string" },
"password": { "type": "string" },
"isAdmin": { "type": "string", "enum": ["admin", "user"], "default": "user" },
"profileImage": { "type": "object", "properties": { "imageUrl": { "type": "string" }, "imgPublicId": { "type": "string" } } }
},
"required": ["firstName", "lastName", "email", "password", "phone"]
},
"LoginUser": { "type": "object", "properties": { "email": { "type": "string" }, "password": { "type": "string" } } },
"Expense": {
"type": "object",
"properties": { "userId": { "type": "string" }, "icon": { "type": "string" }, "category": { "type": "string" }, "amount": { "type": "number" }, "date": { "type": "string", "format": "date" } },
"required": ["category", "amount"]
},
"Income": {
"type": "object",
"properties": { "userId": { "type": "string" }, "icon": { "type": "string" }, "source": { "type": "string" }, "amount": { "type": "number" }, "date": { "type": "string", "format": "date" } },
"required": ["source", "amount"]
},
"DashboardResponse": {
"type": "object",
"properties": {
"data": {
"type": "object",
"properties": {
"totalBalance": { "type": "number" },
"totalIncome": { "type": "number" },
"totalExpense": { "type": "number" },
"last30DaysExpense": {
"type": "object",
"properties": { "total": { "type": "number" }, "transaction": { "type": "array", "items": { "$ref": "#/definitions/Expense" } } }
},
"last60DaysIncome": {
"type": "object",
"properties": { "total": { "type": "number" }, "transaction": { "type": "array", "items": { "$ref": "#/definitions/Income" } } }
},
"recentTransaction": { "type": "array", "items": { "type": "object" } }
}
},
"message": { "type": "string" },
"status": { "type": "number" }
}
}
},
"securityDefinitions": {
"JWTAuth": { "type": "apiKey", "name": "Authorization", "in": "header", "description": "JWT Authorization header using Bearer scheme" }
},
"security": [{ "JWTAuth": [] }]
}
